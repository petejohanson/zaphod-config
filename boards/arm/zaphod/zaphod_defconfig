CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_ZAPHOD=y

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_ZMK_SLEEP=y

CONFIG_ZMK_DISPLAY=y
# The board ships its own Sharp LCD driver (zaphod_ls0xx.c), which toggles
# VCOM in software; turn off Zephyr's.
CONFIG_LS0XX=n
CONFIG_LV_USE_THEME_MONO=y
CONFIG_LV_COLOR_CHROMA_KEY_HEX=0x00FF00

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# The Sharp memory LCD shows LVGL 8 mono "white" as black on ZMK v0.3;
# invert the theme so the screen is black on white.
CONFIG_ZMK_DISPLAY_INVERT=y
